{
  "name": "find-your-dinner",
  "private": true,
  "scripts": {
    "serve": "node --env-file-if-exists=.env server.mjs",
    "encrypt:recipes": "node scripts/encrypt-recipe-data.mjs",
    "install:instagram-browser": "playwright install chromium",
    "test": "node --test",
    "test:backend": "node --test \"tests/backend/*.test.mjs\"",
    "test:ui": "node --test \"tests/ui/*.test.mjs\" \"tests/ui/css/*.test.mjs\"",
    "runrepomix": "repomix --ignore \"**/*.log,tmp,svg,env,gitignore/,recipes.json\""
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.64.1",
    "youtube-dl-exec": "3.1.17"
  }
}
