            border: 2px solid rgba(102, 126, 234, 0.2);
        }

        .portion-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 2px solid #667eea;
            background: white;
            color: #667eea;
            font-size: 1.2em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            line-height: 1;
        }

        .portion-btn:hover {
            background: #667eea;
            color: white;
            transform: scale(1.1);
        }

        .portion-btn:active {
            transform: scale(0.95);
        }

        .portion-display {
            font-weight: 600;
            color: #667eea;
            min-width: 100px;
            text-align: center;
            font-size: 0.95em;
        }

        .portion-display span {
            font-size: 1.3em;
            font-weight: 700;
        }

        .portion-reset {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 2px solid #ff9800;
            background: white;
            color: #ff9800;
            font-size: 1.1em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            margin-left: 5px;
        }

        .portion-reset:hover {
            background: #ff9800;
            color: white;
            transform: scale(1.1);
        }

        .portion-reset:active {
            transform: scale(0.95);
        }

        /* Mobile responsive for portion scaler */
        @media (max-width: 768px) {
            .ingredients-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .portion-scaler {
                width: 100%;
                justify-content: center;
            }
        }

        /* Wake Lock Button Active State */
        #wakeLockBtn {
            transition: all 0.3s ease;
        }
    
    </style>
</body>
